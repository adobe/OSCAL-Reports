# Systemd drop-in for cross-account Bedrock AssumeRole (Phase 2 app; CLI validation in Phase 1).
DROPIN_DIR="/etc/systemd/system/oscal-reporter.service.d"
DROPIN="$DROPIN_DIR/51-oscal-bedrock-env.conf"
mkdir -p "$DROPIN_DIR"
cat > "$DROPIN" <<'BEDROCKENVEOF'
[Service]
Environment=BEDROCK_ASSUME_ROLE_ARN=__BEDROCK_ASSUME_ROLE_ARN__
Environment=BEDROCK_EXTERNAL_ID=__BEDROCK_EXTERNAL_ID__
BEDROCKENVEOF
sed -i "s|__BEDROCK_ASSUME_ROLE_ARN__|${bedrock_assume_role_arn}|g;s|__BEDROCK_EXTERNAL_ID__|${bedrock_external_id}|g" "$DROPIN"
chmod 644 "$DROPIN"

CONFIG_PATH="/opt/oscal/data/config.json"
if [ -f "$CONFIG_PATH" ] && command -v jq >/dev/null 2>&1; then
  jq \
    --arg arn "${bedrock_assume_role_arn}" \
    --arg eid "${bedrock_external_id}" \
    --arg mode "iam-role" \
    '.aiConfig = (.aiConfig // {}) |
     .aiConfig.bedrockAuthMode = $mode |
     .aiConfig.bedrockAssumeRoleArn = $arn |
     .aiConfig.bedrockExternalId = $eid' \
    "$CONFIG_PATH" > "$${CONFIG_PATH}.tmp" && mv "$${CONFIG_PATH}.tmp" "$CONFIG_PATH"
  chown ec2-user:oscal "$CONFIG_PATH" 2>/dev/null || true
fi
