# --- RDS PostgreSQL bootstrap (Terraform Database Integration) ---
set -e
MARKER="/opt/oscal/data/.rds-bootstrap-done"
mkdir -p /opt/oscal/data
if [[ -f "$MARKER" ]]; then
  echo "RDS bootstrap: marker exists, skipping"
else
  dnf install -y postgresql15 jq awscli 2>/dev/null || dnf install -y postgresql jq awscli
  export AWS_DEFAULT_REGION="${aws_region}"
  RDS_HOST="${rds_address}"
  RDS_PORT="${rds_port}"
  DB_NAME="${db_name}"
  ADMIN_USER="${admin_username}"
  SECRET_ARN="${master_secret_arn}"

  echo "RDS bootstrap: waiting for database at $RDS_HOST:$RDS_PORT ..."
  for _attempt in $(seq 1 90); do
    PGPASSWORD="$(aws secretsmanager get-secret-value --secret-id "$SECRET_ARN" --query SecretString --output text 2>/dev/null | jq -r '.password // empty')" || true
    export PGPASSWORD
    if [[ -n "$PGPASSWORD" ]] && psql -h "$RDS_HOST" -p "$RDS_PORT" -U "$ADMIN_USER" -d postgres -c 'SELECT 1' >/dev/null 2>&1; then
      echo "RDS bootstrap: database is reachable"
      break
    fi
    sleep 10
  done

  PGPASSWORD="$(aws secretsmanager get-secret-value --secret-id "$SECRET_ARN" --query SecretString --output text | jq -r '.password')"
  export PGPASSWORD

  cat > /tmp/oscal-rds-create-role.sql <<'ROLESQL'
DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_catalog.pg_roles WHERE rolname = 'ROLEHOLDER') THEN
    EXECUTE format('CREATE ROLE %I LOGIN', 'ROLEHOLDER');
  END IF;
END
$$;
ROLESQL
  sed -i "s/ROLEHOLDER/${iam_db_username}/g" /tmp/oscal-rds-create-role.sql
  psql -h "$RDS_HOST" -p "$RDS_PORT" -U "$ADMIN_USER" -d postgres -v ON_ERROR_STOP=1 -f /tmp/oscal-rds-create-role.sql
  rm -f /tmp/oscal-rds-create-role.sql
  psql -h "$RDS_HOST" -p "$RDS_PORT" -U "$ADMIN_USER" -d postgres -v ON_ERROR_STOP=1 -c "GRANT rds_iam TO \"${iam_db_username}\";"
  psql -h "$RDS_HOST" -p "$RDS_PORT" -U "$ADMIN_USER" -d postgres -v ON_ERROR_STOP=1 -c "GRANT CONNECT ON DATABASE \"${db_name}\" TO \"${iam_db_username}\";"

  psql -h "$RDS_HOST" -p "$RDS_PORT" -U "$ADMIN_USER" -d "$DB_NAME" -v ON_ERROR_STOP=1 -c "GRANT USAGE, CREATE ON SCHEMA public TO \"${iam_db_username}\";"
  psql -h "$RDS_HOST" -p "$RDS_PORT" -U "$ADMIN_USER" -d "$DB_NAME" -v ON_ERROR_STOP=1 -c "GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO \"${iam_db_username}\";"
  psql -h "$RDS_HOST" -p "$RDS_PORT" -U "$ADMIN_USER" -d "$DB_NAME" -v ON_ERROR_STOP=1 -c "GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO \"${iam_db_username}\";"
  psql -h "$RDS_HOST" -p "$RDS_PORT" -U "$ADMIN_USER" -d "$DB_NAME" -v ON_ERROR_STOP=1 -c "ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON TABLES TO \"${iam_db_username}\";"
  psql -h "$RDS_HOST" -p "$RDS_PORT" -U "$ADMIN_USER" -d "$DB_NAME" -v ON_ERROR_STOP=1 -c "ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL ON SEQUENCES TO \"${iam_db_username}\";"

  touch "$MARKER"
  echo "RDS bootstrap: IAM user and grants completed"
fi

# Systemd drop-in for app DB env (runs even when SQL bootstrap was skipped due to marker — fixes missing env if marker predates drop-in).
DROPIN_DIR="/etc/systemd/system/oscal-reporter.service.d"
DROPIN="$DROPIN_DIR/50-oscal-rds-env.conf"
if [[ ! -f "$DROPIN" ]]; then
  mkdir -p "$DROPIN_DIR"
  cat > "$DROPIN" <<'RDSENVEOF'
[Service]
Environment=OSCAL_DATABASE_ENABLED=1
Environment=OSCAL_DATABASE_AUTH=iam
Environment=OSCAL_DATABASE_HOST=__RDS_HOST__
Environment=OSCAL_DATABASE_PORT=__RDS_PORT__
Environment=OSCAL_DATABASE_NAME=__DB_NAME__
Environment=OSCAL_DATABASE_USER=__IAM_DB_USER__
Environment=OSCAL_DATABASE_SSL=require
Environment=OSCAL_DATABASE_RDS_REGION=__AWS_REGION__
RDSENVEOF
  sed -i "s|__RDS_HOST__|${rds_address}|g;s|__RDS_PORT__|${rds_port}|g;s|__DB_NAME__|${db_name}|g;s|__IAM_DB_USER__|${iam_db_username}|g;s|__AWS_REGION__|${aws_region}|g" "$DROPIN"
  chmod 644 "$DROPIN"
fi
