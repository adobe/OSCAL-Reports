# Bootstrap SESSION_SECRET drop-in and ensure SM env on systemd unit (first boot / ASG replacement).
export AWS_DEFAULT_REGION="${aws_region}"
DROPIN_DIR="/etc/systemd/system/oscal-reporter.service.d"
DROPIN="$DROPIN_DIR/52-oscal-session-secret.conf"
SM_ENTRY="OSCAL/session-secret"

command -v jq >/dev/null 2>&1 || dnf install -y jq 2>/dev/null || yum install -y jq 2>/dev/null || true
command -v aws >/dev/null 2>&1 || dnf install -y awscli 2>/dev/null || yum install -y awscli 2>/dev/null || true

if [ -n "${sm_arn}" ] && command -v aws >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  bundle="$(aws secretsmanager get-secret-value --secret-id "${sm_arn}" --query SecretString --output text 2>/dev/null || echo '{}')"
  sess="$(echo "$bundle" | jq -r --arg k "$SM_ENTRY" '.entries[$k] // empty')"
  if [ -z "$sess" ]; then
    sess="$(openssl rand -base64 48 | tr -d '\n' | head -c 64)"
    now="$(date +%s)"
    new_bundle="$(echo "$bundle" | jq --arg s "$sess" --arg k "$SM_ENTRY" --argjson t "$now" \
      '.entries[$k]=$s | ._meta.keys[$k]={"t":$t}')"
    aws secretsmanager put-secret-value --secret-id "${sm_arn}" --secret-string "$new_bundle" || true
  fi
  mkdir -p "$DROPIN_DIR"
  {
    printf '%s\n' '[Service]'
    printf 'Environment=SESSION_SECRET=%s\n' "$sess"
  } >"$DROPIN"
  chmod 644 "$DROPIN"
fi
