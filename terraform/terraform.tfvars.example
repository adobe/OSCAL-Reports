# Example Terraform variables for OSCAL on AWS (AI via AWS Bedrock)
# Copy to terraform.tfvars and set values (terraform.tfvars is gitignored)

aws_region     = "us-east-1"
aws_account_id = "44000000033"
environment    = "prod"
project_name   = "oscal-reports"

# Networking
vpc_cidr          = "10.0.0.0/16"
# Default CIDRs for ALB HTTPS and SSH ingress. PCL custom-config-ec2-sg-port-check disallows 0.0.0.0/0. For stage accounts, prefer /32 to avoid PCL "broad CIDR" quarantine (e.g. VPN egress IPs as /32).
# Composing the list (mixed /32 + /24, comments, curl ifconfig.me, run-with-aws-pass.sh): docs/TERRAFORM_NETWORK_PCL_AND_TAGS.md §3.1a
default_allowed_cidr_blocks = ["1.2.3.4/32"]  # Your IP(s) or VPN subnet; add end-of-line # comments per entry in real tfvars

# EC2: existing key pair for SSH (optional; omit or set null to launch without SSH key)
# Create in AWS Console: EC2 → Key Pairs → Create, or: aws ec2 create-key-pair --key-name oscal-aws4403 --query 'KeyMaterial' --output text > oscal-aws4403.pem
key_name = null
# Instance type: preferred Graviton (t4g) then AMD (t3a). Default t4g.small (arm64). For AMD use t3a.small with instance_architecture = "x86_64".
# instance_type          = "t4g.small"
# instance_architecture  = "arm64"

# S3 (best practice from docs/AWS_OPERATIONS.md#adobe-image-factory-ami-usage-for-terraform): lowercase, globally unique; AMS prefix ams-oscal-<account-id>
# Subfolders: logs, config, users. Terraform lowercases the value.
s3_logs_bucket_name = "ams-oscal-442277170733"

# ------------------------------------------------------------------------------
# ALB HTTPS and custom domain (e.g. https://oscal.amsgovcloud.com.au/)
# ------------------------------------------------------------------------------
# Option A – Terraform requests the certificate: set create_alb_certificate = true and alb_domain_name.
# After apply: add the CNAMEs from output acm_certificate_validation_records in Route53 (manual).
# Then add an A record (alias) for alb_domain_name pointing to the ALB (output alb_dns_name).
# Option B – Use an existing cert: set alb_ssl_certificate_arn and leave create_alb_certificate = false.
# ------------------------------------------------------------------------------
# create_alb_certificate = true
# alb_domain_name        = "oscal.amsgovcloud.com.au"
# alb_certificate_ready   = false  # Set to true ONLY after ACM cert is Issued (CNAMEs added in Route53); then apply to create 443 listener
# alb_ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-Res-PQ-2025-09"   # match existing ALB policy (optional)
# alb_ssl_certificate_arn = null   # ignored when create_alb_certificate = true

# Optional: existing ACM certificate ARN (when create_alb_certificate = false)
# alb_ssl_certificate_arn = "arn:aws:acm:us-east-1:442277170733:certificate/..."

# Optional: Host-based routing for Blue and Green (same app at / on two hostnames)
# Create CNAME records pointing blue.xxx and green.xxx to the ALB DNS (output alb_dns_name).
# alb_blue_hostname  = "blue.oscal.example.com"
# alb_green_hostname = "green.oscal.example.com"

# ALB port 80 for testing: set alb_allow_http_for_testing = true to allow HTTP from default_allowed_cidr_blocks only; default false.
# alb_allow_http_for_testing = false

# AMS PCL: ALB is tagged Adobe:PublicPorts and Adobe:PortJustification automatically. Override justification if needed:
# alb_port_justification = "OSCAL Report Generator production access for AMS Gov Cloud"

# ------------------------------------------------------------------------------
# Image Factory / AMI (docs/AWS_OPERATIONS.md#adobe-image-factory-ami-usage-for-terraform): default = Image Factory Amazon Linux 2023 (when in map), else native Amazon Linux 2023
# ------------------------------------------------------------------------------
# - use_image_factory_ami = true (default): Image Factory Amazon Linux 2023 if AMI set below or in image_factory_ami.tf; else native AL2023.
# - use_image_factory_ami = false: use only native Amazon Linux 2023 (e.g. sandbox without Image Factory access).
# - Set image_factory_amazon_linux_ami_us_east_1 to pin a specific EMR AMI, or leave null and enable dynamic lookup below.
# - Leave oscal_ami_id null so both use the same chain (Image Factory EMR or native AL2023).
# ------------------------------------------------------------------------------
# use_image_factory_ami = true
# image_factory_amazon_linux_ami_us_east_1 = null
# image_factory_dynamic_emr_lookup_enabled = true
# image_factory_prefer_dynamic_emr_lookup  = true
# oscal_ami_id          = null
# instance_architecture = "arm64"   # default for t4g (Graviton); use "x86_64" for t3a (AMD)

# ------------------------------------------------------------------------------
# RDS PostgreSQL (Database Integration; IAM DB auth). Enabled by default (variables.tf). To skip RDS and private subnets:
# create_rds_postgres = false
# ------------------------------------------------------------------------------
# rds_instance_class  = "db.t4g.micro"
# rds_engine_version  = "16.13"   # initial create only; live minor patches are ignored (see rds.tf lifecycle)
# rds_skip_final_snapshot = true  # set false + rds_deletion_protection = true for production

# Optional tags
common_tags = {
  Team = "Compliance"
}

# ------------------------------------------------------------------------------
# Resilience: persistent EBS + ASG + SSM (direct-run only; see docs/AWS_OPERATIONS.md#aws-terraform-for-oscal-ai-via-bedrock)
# ------------------------------------------------------------------------------
# oscal_persistent_ebs_enabled      = true   # extra gp3 per Green/Blue, mounted at /opt/oscal
# oscal_data_volume_size_gb         = 50
# oscal_asg_health_check_grace_period = 420  # seconds before ELB health affects ASG (tune if flapping)

# Blue/Green active-passive (Blue primary, Green standby scale-to-zero when idle)
# oscal_traffic_mode                  = "active_passive"  # or "active_active" for legacy 50/50
# oscal_active_role                   = "blue"
# oscal_passive_role                  = "green"
# oscal_passive_min_size              = 0
# oscal_passive_idle_shutdown_hours   = 4
# oscal_standby_automation_enabled    = true
# oscal_deploy_edge_canary_enabled    = true

# oscal_ssm_post_boot_association_enabled = true   # periodic SSM document on tag OSCAL_SSM_TARGET=true
# oscal_ssm_release_s3_prefix       = null  # e.g. "releases/current" inside s3_logs_bucket_name for SSM sync

# SSM Patch Manager — staggered Blue/Green OS patching (see docs/AWS_OPERATIONS.md#os-patching-ssm-patch-manager)
# oscal_os_patch_enabled          = true
# oscal_os_patch_hour             = 2      # UTC; 02:00 UTC ≈ 12:00/13:00 Sydney (AEST/AEDT)
# oscal_os_patch_reboot_option     = "RebootIfNeeded"   # or "NoReboot"
# oscal_os_patch_approval_days      = 1      # default 1 for ≤7-day SLA (was 7)
# oscal_os_patch_weekly_scan_enabled = true
# oscal_os_patch_on_launch_enabled   = true
# oscal_ami_auto_refresh_on_change   = false  # set true during AMI bump apply (staggered ASG refresh)
# oscal_splunk_uf_upgrade_enabled  = true
# oscal_splunk_uf_min_version        = "9.3.9"
# oscal_splunk_uf_bootstrap_enabled  = true
# oscal_splunk_deployment_server     = "ds2.splunk.adobe.net:443"
# oscal_splunk_client_name           = "DC-ue1-journald_seclogs-ams-oscal"

# ------------------------------------------------------------------------------
# Docker on EC2 (optional; default is direct Node.js run + deploy-to-ec2.sh)
# ------------------------------------------------------------------------------
# run_oscal_via_docker   = false
# oscal_container_image  = "ghcr.io/adobe/oscal-report-generator:latest"

# ------------------------------------------------------------------------------
# Cross-account Bedrock (Account B) — see docs/CROSS_ACCOUNT_BEDROCK_PHASE1.md
# ------------------------------------------------------------------------------
# bedrock_cross_account_enabled        = true
# bedrock_account_id                   = "928475551084"
# bedrock_assume_role_arn              = "arn:aws:iam::928475551084:role/OSCAL-BedrockCrossAccount"
# bedrock_assume_role_name             = "OSCAL-BedrockCrossAccount"
# bedrock_external_id                  = "<from Account B trust policy, if trust uses ExternalId>"
# bedrock_inject_systemd_env           = true
# bedrock_runtime_vpc_endpoint_enabled = false
