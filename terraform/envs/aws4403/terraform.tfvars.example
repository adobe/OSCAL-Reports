# Example for AWS4403 (Account ID 442277170733). Copy to terraform.tfvars and set key_name if needed.
# Credentials: pass show "AWS/AMS_4403-STG"

aws_region     = "us-east-1"
aws_account_id = "442277170733"
environment    = "prod"
project_name   = "ams-oscal-reports"

vpc_cidr         = "10.0.0.0/16"
# Default CIDRs for ALB HTTP testing, SSH, and direct Green/Blue app access (port 3020). PCL disallows 0.0.0.0/0.
default_allowed_cidr_blocks = ["1.2.3.4/32"]  # Replace with your IP(s), e.g. ["130.248.32.17/32", "203.191.182.150/32"]
# alb_allow_http_for_testing = false  # Set true to open ALB port 80 from default_allowed_cidr_blocks only (for testing)
# AMS PCL: ALB is tagged Adobe:PublicPorts and Adobe:PortJustification automatically. Override if needed:
# alb_port_justification = "OSCAL Report Generator production access for AMS Gov Cloud"

key_name = null  # Or "oscal-aws4403" after importing key: AWS_PASS_ENTRY=AWS/AMS_4403-STG ... run-with-aws-pass.sh import-key us-east-1

s3_logs_bucket_name = "ams-oscal-442277170733"

# AMI: AMS InfraSec (e.g. SSAAU-209) — use latest Image Factory **Amazon Linux 2023 EMR** for us-east-1.
# UI: https://imagefactory.corp.adobe.com/imagefactoryui/ui/flavor?orgName=DME&ownerTeamName=ImageFactory&typeName=aws&flavorName=Amazon%20Linux%202023%20EMR
# CLI (with AWS creds): ../../scripts/list-emr-candidate-amis.sh us-east-1 x86_64   # or arm64 for t4g
use_image_factory_ami = true
# Recommended: dynamic EMR lookup (newest shared AMI at plan/apply). Leave static pin null.
image_factory_amazon_linux_ami_us_east_1 = null
image_factory_dynamic_emr_lookup_enabled = true
image_factory_prefer_dynamic_emr_lookup  = true
instance_architecture   = "x86_64" # or "arm64" for t4g.small
instance_type           = "t3a.small" # or "t4g.small" with arm64

# Optional: freeze a specific AMI ID (set image_factory_prefer_dynamic_emr_lookup = false)
# image_factory_amazon_linux_ami_us_east_1 = "ami-xxxxxxxx"

# Optional: dynamic latest AMI by owner + pattern (alternative to executable-users lookup)
# image_factory_owner_id         = "000000000000"  # Image Factory / sharing account (from platform wiki)
# image_factory_ami_name_pattern = "*Amazon*Linux*2023*EMR*"

# RDS PostgreSQL for Database Integration (IAM auth; app creates tables on first use).
# RDS uses private subnets only (no public IP). Ingress defaults to OSCAL EC2 SG only.
# Optional extra CIDRs (VPC-internal): rds_additional_ingress_ipv4_cidr_blocks = ["10.0.20.0/28"]
create_rds_postgres = true
# rds_instance_class          = "db.t4g.micro"
# rds_skip_final_snapshot     = true   # set false + rds_deletion_protection = true for production

common_tags = {
  Team        = "Compliance"
  Account     = "AWS4403"
  Environment = "staging"
}

# Optional: override default tag "Service ID" (Adobe CMDB / chargeback). Default is 602844 via variables.tf.
# adobe_service_id_tag = "602844"

# Resilience (direct-run): ASG + optional gp3 at /opt/oscal + SSM (see docs/AWS_OPERATIONS.md#aws-terraform-for-oscal-ai-via-bedrock)
# oscal_persistent_ebs_enabled = true
# oscal_data_volume_size_gb    = 50
# oscal_asg_health_check_grace_period = 420

# Blue/Green active-passive (Blue primary, Green standby scale-to-zero)
# oscal_traffic_mode                = "active_passive"
# oscal_active_role                   = "blue"
# oscal_passive_role                  = "green"
# oscal_passive_min_size              = 0
# oscal_passive_idle_shutdown_hours   = 4
# oscal_standby_automation_enabled    = true
# oscal_deploy_edge_canary_enabled    = true

# oscal_ssm_post_boot_association_enabled = true   # recommended: Splunk/health self-heal every 30 min (SSAAU-212)
# oscal_ssm_release_s3_prefix  = null   # e.g. "releases/current" inside s3_logs_bucket_name

# SSM Patch Manager — staggered Blue/Green OS patching (see docs/AWS_OPERATIONS.md#os-patching-ssm-patch-manager)
# oscal_os_patch_enabled          = true
# oscal_os_patch_hour             = 2      # UTC; 02:00 UTC ≈ 12:00/13:00 Sydney (AEST/AEDT)
# oscal_os_patch_reboot_option     = "RebootIfNeeded"   # or "NoReboot"
# oscal_os_patch_approval_days      = 1
# oscal_os_patch_weekly_scan_enabled = true
# oscal_os_patch_on_launch_enabled   = true
# oscal_ami_auto_refresh_on_change   = false
oscal_splunk_uf_upgrade_enabled  = true
oscal_splunk_uf_min_version        = "9.3.9"
# oscal_splunk_uf_bootstrap_enabled  = true
# oscal_splunk_deployment_server     = "ds2.splunk.adobe.net:443"
# oscal_splunk_client_name           = "DC-ue1-journald_seclogs-ams-oscal"

# ------------------------------------------------------------------------------
# Docker on EC2 (optional; default is direct Node.js run + deploy-to-ec2.sh)
# ------------------------------------------------------------------------------
# run_oscal_via_docker   = false
# oscal_container_image  = "ghcr.io/adobe/oscal-report-generator:latest"

# ------------------------------------------------------------------------------
# Cross-account Bedrock (Account B) — see docs/CROSS_ACCOUNT_BEDROCK_PHASE1.md
# ------------------------------------------------------------------------------
# bedrock_cross_account_enabled        = true
# bedrock_account_id                   = "928475551084"
# bedrock_assume_role_arn              = "arn:aws:iam::928475551084:role/OSCAL-BedrockCrossAccount"
# bedrock_assume_role_name             = "OSCAL-BedrockCrossAccount"
# bedrock_external_id                  = "<from Account B trust policy sts:ExternalId, if used>"
# bedrock_inject_systemd_env           = true
# bedrock_runtime_vpc_endpoint_enabled = false
