config/app/config.json
config/app/users.json
config/app/config.json.backup
config/app/users.json.backup
config/app/*.backup
config/app/config.json.tmp.*
config/app/users.json.tmp.*
config/app/okta_oidc_state.json
config/app/local.oscal-report-generator.status.yml
config/app/email_blocklist.json
config/app/email_blacklist.json
config/app/email_blocklist.json.backup
config/app/email_blacklist.json.backup
backend/okta-debug.ndjson
backend/auth/users.json
backend/config.json
credentials.txt

# Runtime data
backend.pid
frontend.pid
*.pid

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Test coverage (but keep test_cases/ directory - it contains test code & validation scripts)
coverage/
.nyc_output/
# NOTE: test_cases/ folder IS committed to git - it contains test files & validation scripts

# Temporary files
tmp/
temp/
*.tmp

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Cache directories
__pycache__/
*.py[cod]
.cache/
.parcel-cache/
.next/
.nuxt/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Docker volumes and data
docker-data/
volumes/

# Backup files
*.bak
*.backup
*~
backups/
data/

# SSL certificates (if any) — keep CSRs/keys outside repo (e.g. ../OSCAL_Reports_data/tls/)
*.pem
# Public AWS RDS CA bundle (not a secret; used by backend for RDS TLS verification)
!backend/database/rds-global-bundle.pem
*.csr
*.key
oscal.csr
oscal-private.key
*.crt
*.p12
*.pfx

# Database files (if using local SQLite, etc.)
*.db
*.sqlite
*.sqlite3

# User-uploaded files (if applicable)
uploads/
user-data/
backend/Published_OSCAL/
config/app/published-soa/
.cursor/

# Terraform (tfvars may contain secrets)
terraform/*.tfvars
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.zip
