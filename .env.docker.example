# Concept: Mukesh Kesharwani
# Contact: mukesh.kesharwani@adobe.com
#
# Docker / TrueNAS deployment template for Generic SSO (Authentik) and the Guardian Agent assessment feature.
# Full guide: docs/GUARDIAN_SSO_DOCKER_DEPLOYMENT.md
#
# HOW TO USE
#   1. Copy this file to ".env.docker" in the deployment folder (the one holding docker-compose.yml and scripts/).
#      Do NOT reuse the repository's developer ".env".
#        cp .env.docker.example .env.docker
#   2. Replace every <placeholder>. Leave a block commented out (or its values empty) to keep that feature off.
#   3. Start or restart the container. The application reads these once at start:
#        docker compose:           docker compose --env-file .env.docker up -d --force-recreate
#        TrueNAS install script:   ./scripts/install_from_dockerhub.sh   (picks up .env.docker automatically;
#                                  set OSCAL_ENV_FILE=/path/to/file to use another name)
#        plain docker:             docker run ... --env-file .env.docker ...
#
# RULES
#   - Never commit the filled-in file. It must not contain secrets; the client secret is saved in the app
#     (Settings -> SSO Integration) or supplied through your secret manager, not here.
#   - A value is passed through exactly as written. Do not add spaces around "=".
#   - The targets JSON (below) is one line. Wrap it in single quotes for docker compose; "docker run --env-file"
#     also works with or without the single quotes.

# ---------------------------------------------------------------------------------------------------------------
# 1. Generic SSO (Authentik) identity: ONE place for the identity host (used by sign-in AND by Guardian)
# ---------------------------------------------------------------------------------------------------------------
# Exact issuer shown by the IdP: https, ends with "/", no query or fragment. The discovery, end-session and Guardian
# key URLs are derived from it (Authentik layout: .well-known/openid-configuration, end-session/, jwks/).
# If unset, the values saved in the container's /data/config.json are used.
OSCAL_GENERIC_SSO_ISSUER=https://<sso-host>/application/o/<application-slug>/
# OAuth client ID of the OSCAL application in the IdP (also the access-token audience Guardian checks).
OSCAL_GENERIC_SSO_CLIENT_ID=<oauth-client-id>

# ---------------------------------------------------------------------------------------------------------------
# 2. Guardian Agent assessments (privileged Generic SSO operators fetch real control assessments into an SSP)
#    Leave ENABLED=false (the default) to switch the feature off.
# ---------------------------------------------------------------------------------------------------------------
OSCAL_GUARDIAN_ASSESSMENTS_ENABLED=false

# Guardian's "authentik" endpoint (from Guardian's `assessment_api_endpoints` output): https, ends with /v1/guardian.
OSCAL_GUARDIAN_GENERIC_SSO_ASSESSMENTS_URL=https://<api-id>.execute-api.<region>.amazonaws.com/v1/guardian
# Exact host names allowed for the URL above. Comma separated, lowercase, no wildcards. Nothing is allowed by default.
OSCAL_GUARDIAN_ASSESSMENTS_ALLOWED_HOSTS=<api-id>.execute-api.<region>.amazonaws.com

# Custom scope that Guardian requires in the access token. While the Guardian feature is enabled, the application adds it
# to the Generic SSO sign-in request automatically (single plain scope name, no spaces), so it does not also have to be
# saved in Settings. The IdP must offer it to the approved groups.
OSCAL_GUARDIAN_GENERIC_SSO_SCOPE=guardian-assessments

# Longest access-token lifetime Guardian accepts, in seconds (60 to 3600, default 600). It MUST equal Guardian's
# maxTokenAgeSeconds and be at least the IdP's access-token validity; otherwise every token is rejected.
OSCAL_GUARDIAN_GENERIC_SSO_MAX_TOKEN_AGE_SECONDS=600

# Operators: members of an IdP group whose name CONTAINS one of these phrases (case-insensitive, comma separated).
OSCAL_GUARDIAN_PRIVILEGED_GROUPS=Platform Admin

# Targets an operator may fetch: a JSON array (at most 100) on ONE line. "groups" are the exact group names in the
# ACCESS token that may use the target. Guardian applies its own grants as well. Providers: cloudflare, okta.
# Keep the single quotes for docker compose.
OSCAL_GUARDIAN_ASSESSMENT_TARGETS_JSON='[{"provider":"cloudflare","targetId":"<target-id>","label":"<Display label>","groups":["<idp-group-name>"]},{"provider":"okta","targetId":"<target-id>","label":"<Display label>","groups":["<idp-group-name>"]}]'

# ---------------------------------------------------------------------------------------------------------------
# 3. Optional overrides (normally leave unset)
# ---------------------------------------------------------------------------------------------------------------
# Guardian-only overrides of section 1, for an IdP whose key URL is not <issuer>jwks/:
# OSCAL_GUARDIAN_GENERIC_SSO_ISSUER=
# OSCAL_GUARDIAN_GENERIC_SSO_JWKS_URL=
# OSCAL_GUARDIAN_GENERIC_SSO_CLIENT_ID=

# Public IdP with an incomplete TLS chain (homelab only; prefer fixing the chain): 1 turns strict checking off.
# OSCAL_GENERIC_OIDC_TLS_RELAXED=

# Host port published by docker-compose (default 3020).
# EXTERNAL_PORT=3020
