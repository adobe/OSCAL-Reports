flowchart TB
    subgraph Internet["Internet"]
        Users["Users<br/>Browser/API"]
    end

    subgraph AWS["AWS Cloud US-East-1"]
        subgraph LoadBalancer["Application Load Balancer"]
            ALB["Port 80/443<br/>Health Checks<br/>SSL Termination"]
        end

        subgraph OSCAL["OSCAL Instances Always On"]
            Green["Green Instance<br/>t4g.small (Graviton) 2vCPU 2GB<br/>Port: 3019"]
            Blue["Blue Instance<br/>t4g.small (Graviton) 2vCPU 2GB<br/>Port: 3020"]
        end

        subgraph Storage["Storage"]
            S3["S3 Bucket<br/>logs, config, users<br/>Sync/mount from instances"]
        end

        subgraph AI["AI - AWS Bedrock"]
            Bedrock["Bedrock API<br/>Mistral / Gemma etc.<br/>Pay-per-use"]
        end
    end

    Users -->|HTTPS| ALB
    ALB -->|Health Check| Green
    ALB -->|Health Check| Blue
    ALB -->|Route Traffic| Green
    ALB -->|Route Traffic| Blue

    Green -->|Config/Users Sync| S3
    Blue -->|Config/Users Sync| S3

    Green -->|AI Suggest| Bedrock
    Blue -->|AI Suggest| Bedrock
    Bedrock -->|Response| Green
    Bedrock -->|Response| Blue

    style Users fill:#e1f5ff,stroke:#0066cc,stroke-width:2px
    style ALB fill:#ff9900,stroke:#cc7a00,stroke-width:3px
    style Green fill:#90EE90,stroke:#228B22,stroke-width:2px
    style Blue fill:#87CEEB,stroke:#4682B4,stroke-width:2px
    style S3 fill:#569A31,stroke:#3d6d23,stroke-width:2px
    style Bedrock fill:#232F3E,stroke:#ff9900,stroke-width:2px

    classDef awsGroup fill:#f9f9f9,stroke:#232F3E,stroke-width:2px,stroke-dasharray: 5 5
    class LoadBalancer,OSCAL,Storage,AI awsGroup
